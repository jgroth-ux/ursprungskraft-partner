+# Bestellseite je Sportler unter /<seite>/bestellen/ aus einer Vorlage. Kürzel und Adresse kommen aus dem Aufruf von seite,
+# Name, Rolle und Vorname aus der Sportseite (Kopfleiste und data-vorname), damit sie nur an einer Stelle stehen.
+bestellseite() {
+  local quelle="$WEB/partner/$1/index.html" name rolle vorname
+  name=$(sed -n 's#.*<span class="marke"><b>\([^<]*\)</b><span>\([^<]*\)</span></span>.*#\1#p' "$quelle" | head -1)
+  rolle=$(sed -n 's#.*<span class="marke"><b>\([^<]*\)</b><span>\([^<]*\)</span></span>.*#\2#p' "$quelle" | head -1)
+  vorname=$(sed -n 's#.*data-vorname="\([^"]*\)".*#\1#p' "$quelle" | head -1)
+  [ -n "$name" ] && [ -n "$rolle" ] && [ -n "$vorname" ] || { echo "ABBRUCH: Name, Rolle oder Vorname für $2/bestellen nicht gefunden."; exit 1; }
+  esc() { printf '%s' "$1" | sed 's/[#&\\]/\\&/g'; }
+  mkdir -p "$ZIEL/$2/bestellen"
+  sed -e "s#{{KURZ}}#$1#g" -e "s#{{SEITE}}#$2#g" -e "s#{{NAME}}#$(esc "$name")#g" \
+      -e "s#{{ROLLE}}#$(esc "$rolle")#g" -e "s#{{VORNAME}}#$(esc "$vorname")#g" \
+      "$QUELLE/bestellen/vorlage.html" > "$ZIEL/$2/bestellen/index.html"
+  grep -q '{{' "$ZIEL/$2/bestellen/index.html" && { echo "ABBRUCH: In $2/bestellen ist ein Platzhalter offen."; exit 1; }
   return 0
 }
